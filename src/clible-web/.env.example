# GEMINI_API_KEY: Required for Gemini AI API calls (create at https://aistudio.google.com/apikey ).
# Prefer no quotes: GEMINI_API_KEY=AIza...  (quotes are tolerated; the server strips them.)
# AI Studio may inject this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GEMINI_API_KEY_FOR_BETA_TESTERS: Separate key for beta testing to track usage independently
GEMINI_API_KEY_FOR_BETA_TESTERS=MY_BETA_GEMINI_API_KEY

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_DOCS_SITE_URL: Published documentation root (VitePress site). No trailing slash.
# Default when unset: https://mvirtai.github.io/clible-v2 — footer links use this for Documentation + API.
# For a fork or custom domain: https://yourdomain.github.io/your-repo
# VITE_DOCS_SITE_URL=https://mvirtai.github.io/clible-v2

# CLIBLE_AUTO_SEED: Comma-separated list of translation IDs to install automatically
# on server startup. Already-installed translations are skipped silently.
# Example: CLIBLE_AUTO_SEED=web,greeksblgnt,fin-1992,fin-stlk,eng-darby
CLIBLE_AUTO_SEED=web,greeksblgnt,fin-1992,heb-leningrad
