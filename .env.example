# Copy to `.env` and customize locally.
# Do not commit secrets.

CLIBLE_DOCKER_REPO=docker.io/mvirtai/clible-v2
# -----------------------------------------------------------------------------
# How the three env-related files work (dev local setup)
# -----------------------------------------------------------------------------
#
#   .env.example  (this file)  →  Committed. Just a template: variable names + hints.
#        ↓ you copy and fill in
#   .env                      →  Not committed. Your real values (secrets, paths).
#        ↑ loaded by
#   .envrc                    →  Committed. Uses "dotenv_if_exists .env" and
#                                exports safe defaults for non-secret values.
#
# So: you cd into the project → direnv runs .envrc → .env is loaded → Python
# sees CLIBLE_* in os.environ. No Python package needed to read .env.
#
# Override per environment: dev (.env), test (pytest env), Docker (-e / env_file).
# -----------------------------------------------------------------------------
#
# CLIBLE_DB_PATH=
# CLIBLE_API_BASE_URL=https://api.bible-api.com
# CLIBLE_TRANSLATIONS=KJV,ESV,NIV
# CLIBLE_DATA_DIR=
# CLIBLE_REQUEST_TIMEOUT=10
# CLIBLE_REQUEST_DELAY=1
# CLIBLE_DOCKER_REPO=docker.io/mvirtai/clible-v2
# CLIBLE_GCS_BUCKET=clible_v2dev_bucket
# CLIBLE_GCP_ARTIFACT_REGISTRY=europe-north1-docker.pkg.dev/clible-v2dev/clible
# CLIBLE_ANALYTICS_LANGUAGE=en
#   Language code for stopword filtering in analytics (default: en).
#   Independent of the selected Bible translation's language — the CLI
#   interface and analytics labels are always English.
#   Override to match the text language only when analyzing Greek or other
#   non-English text at the linguistic level (e.g. CLIBLE_ANALYTICS_LANGUAGE=grc).
