# Load production-style defaults first, then local overrides.
# Run: direnv allow
source_env_if_exists .env.production
source_env_if_exists .env

# Docker image destination and tags are configured via env vars so that
# credentials and private overrides stay out of git.
export CLIBLE_DOCKER_REPO="${CLIBLE_DOCKER_REPO:-docker.io/mvirtai/clible-v2}"
export CLIBLE_GCP_ARTIFACT_REGISTRY="${CLIBLE_GCP_ARTIFACT_REGISTRY}"
export CLIBLE_GCS_BUCKET="${CLIBLE_GCS_BUCKET}"
export GEMINI_API_KEY="${GEMINI_API_KEY}"
export GEMINI_MODEL_INSIGHT="${GEMINI_MODEL_INSIGHT}"
export GEMINI_MODEL_TONE="${GEMINI_MODEL_TONE}"
export SESSION_SECRET="${SESSION_SECRET}"
export GCP_PROJECT_ID="${GCP_PROJECT_ID}"
export GCP_REGION="${GCP_REGION:-${REGION:-europe-north1}}"
export REGION="${REGION:-$GCP_REGION}"
export GEMINI_API_KEY_FOR_BETA_TESTERS="${GEMINI_API_KEY_FOR_BETA_TESTERS:-$GEMINI_API_KEY_FOR_BETAS}"
export GEMINI_API_KEY_FOR_BETAS="${GEMINI_API_KEY_FOR_BETAS:-$GEMINI_API_KEY_FOR_BETA_TESTERS}"
export MAX_REQUESTS_PER_HOUR="${MAX_REQUESTS_PER_HOUR:-20}"
export CLIBLE_POSTGRES_PASSWORD="${CLIBLE_POSTGRES_PASSWORD}"
export CLIBLE_POSTGRES_USER="${CLIBLE_POSTGRES_USER}"